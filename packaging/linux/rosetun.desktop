# The menu entry. Installed as /usr/share/applications/rosetun.desktop, with
# crates/rosetun-gui/assets/icon/rosetun.svg as
# /usr/share/icons/hicolor/scalable/apps/rosetun.svg. Wayland finds this file by
# the window's app ID, `rosetun`; X11 by the window class, the program's file name.
[Desktop Entry]
Type=Application
Name=Rosetun
Comment=VPN client
Exec=/usr/lib/rosetun/rosetun-gui
Icon=rosetun
Terminal=false
Categories=Network;
StartupNotify=true
StartupWMClass=rosetun-gui
