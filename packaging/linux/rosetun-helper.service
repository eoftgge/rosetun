# Rosetun privileged helper. Installed as
# /usr/lib/systemd/system/rosetun-helper.service; the helper, sing-box and xray
# live in /usr/lib/rosetun, owned by root and writable by nobody else (the
# helper refuses to run engines from anywhere else).

[Unit]
Description=Rosetun privileged helper
After=network.target
# Both may start with `flush ruleset`, which would take the helper's table with
# it. Neither is needed, so this only orders them when they are there.
After=nftables.service firewalld.service
# Never give up restarting. A kill switch's table outlives a crash, so a service
# that stayed down would leave the network closed with nobody to open it but
# `rosetun reset-firewall`. RestartSec keeps the attempts cheap.
StartLimitIntervalSec=0

[Service]
# The helper sends READY=1 once its socket is published and STOPPING=1 when a
# stop begins. Only the main process may notify: the engines it starts never
# speak for the service.
Type=notify
NotifyAccess=main
ExecStart=/usr/lib/rosetun/rosetun-helper-privileged --service

# /run/rosetun holds the client socket (group rosetun, mode 0660) and the
# helper's private engine configuration. systemd removes the folder on every
# stop, crash and restart, so a socket left by a killed helper never blocks
# the next start; the helper itself never deletes an endpoint it does not own.
RuntimeDirectory=rosetun
RuntimeDirectoryMode=0755
# /var/lib/rosetun: lists and state, root only.
StateDirectory=rosetun
StateDirectoryMode=0700

# SIGTERM goes to the helper alone, which stops the engines itself (SIGTERM
# to each engine's process group, then a kill after 12 s) before it exits.
# Whatever is left after that is killed with the rest of the unit. If the
# helper dies instead, the kernel sends each engine SIGTERM at once (the
# helper sets a parent-death signal), and systemd kills what remains.
KillMode=mixed
# The session's sing-box (12 s) and Xray (5 s), and a running server check's
# pair, can each take their full wait; the rest of the teardown is short.
TimeoutStopSec=45
Restart=on-failure
RestartSec=2

# The kill switch permits the engines by cgroup. The helper gets this unit's
# cgroup subtree, makes the leaves "helper" (itself) and "engines" (every
# engine, moved there before it runs). Without them engines start in the
# helper's own cgroup and there is no kill switch or DNS lock. It enables no
# controller: "yes" is just how systemd spells handing over the subtree.
Delegate=yes
# The nftables table (inet rosetun) is removed by the helper on a normal
# stop. On purpose there is no ExecStopPost that removes it: after a crash, or
# a stop for a package upgrade (the package's prerm leaves the file "upgrading"
# in /run/rosetun), the table keeps the network closed until the restarted
# helper is asked to open it or a connect replaces it.

# All this service and its engines may ever hold. The engines keep the first
# three (see rosetun_engine::process) and run as rosetun-engine:
# - CAP_NET_ADMIN: the TUN device, routes and rules, nftables;
# - CAP_NET_RAW: binding a socket to the physical interface;
# - CAP_NET_BIND_SERVICE: a local proxy on a port below 1024.
# Only a session with an enabled rule by program also gives its sing-box these
# two, to find which program owns a connection in /proc:
# - CAP_SYS_PTRACE: the links exe and fd/* of other accounts' processes;
# - CAP_DAC_READ_SEARCH: listing their fd folders.
# With both that sing-box can read any file and inject code into any process,
# the helper too: nearly root. Without such a rule no engine has them, and
# without them here a rule by program is refused.
# The helper needs the rest:
# - CAP_SETUID, CAP_SETGID: an engine takes its account before it runs;
# - CAP_KILL: stopping an engine that runs as another account;
# - CAP_CHOWN: the socket's group rosetun, the engine folders' group;
# - CAP_DAC_READ_SEARCH: finding the GUI's and the CLI's scopes in cgroup folders
#   of other accounts.
# It owns everything else it touches, so CAP_DAC_OVERRIDE and CAP_SYS_ADMIN stay
# out.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_KILL CAP_CHOWN CAP_DAC_READ_SEARCH CAP_SYS_PTRACE

# Hardening, limited to what cannot touch the TUN device, routes, /proc,
# nftables or the cgroup tree (so no ProtectControlGroups or
# ProtectKernelTunables, which make /sys/fs/cgroup read-only):
# - the helper runs no set-user-ID program, and needs no privilege it lacks;
NoNewPrivileges=yes
# - neither the helper nor the engines use /tmp;
PrivateTmp=yes
# - nothing here sets the host name;
ProtectHostname=yes
# - Go and Rust programs never change the execution domain;
LockPersonality=yes
# - nothing here asks for real-time scheduling;
RestrictRealtime=yes
# - nothing here creates set-user-ID or set-group-ID files;
RestrictSUIDSGID=yes
# - the helper and the engines are native 64-bit programs.
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
