{
  "outbounds": [
    {"type": "selector", "tag": "proxy", "outbounds": ["Test VLESS"]},
    {"type": "direct", "tag": "direct"},
    {
      "type": "vless",
      "tag": "Test VLESS",
      "server": "vless.example.com",
      "server_port": 443,
      "uuid": "11111111-1111-1111-1111-111111111111",
      "tls": {
        "enabled": true,
        "server_name": "example.com",
        "utls": {"enabled": true, "fingerprint": "chrome"}
      },
      "transport": {
        "type": "ws",
        "path": "/test",
        "headers": {"Host": "cdn.example.com"}
      }
    },
    {"type": "urltest", "tag": "automatic", "outbounds": ["Test VLESS"]},
    {
      "type": "shadowsocks",
      "tag": "Test Shadowsocks",
      "server": "ss.example.com",
      "server_port": 443,
      "method": "aes-256-gcm",
      "password": "test-password"
    },
    {"type": "dns", "tag": "dns"},
    {"type": "block", "tag": "block"}
  ]
}