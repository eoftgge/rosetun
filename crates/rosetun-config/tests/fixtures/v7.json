            "template": "youtube"
          },
          "target": "block"
        },
        {
          "id": "template-torrents",
          "enabled": true,
          "matcher": {
            "template": "torrents"
          },
          "target": "direct"
        },
        {
          "id": "list-example",
          "enabled": true,
          "matcher": {
            "list": {
              "list": "2",
              "category": "example@cn"
            }
          },
          "target": "direct"
        }
