        {
          "id": "domain-suffix",
          "enabled": true,
          "matcher": {
            "domain": {
              "suffix": "suffix.example.com"
            }
          },
          "target": "proxy"
        },
        {
          "id": "domain-keyword",
          "enabled": false,
          "matcher": {
            "domain": {
              "keyword": "keyword"
            }
          },
          "target": "block"
        },
        {
          "id": "process-name",
