  "rule_sets": [
    {
      "id": "routing",
      "name": "Full routing rules",
      "rules": [
        {
          "id": "domain-exact",
          "enabled": true,
          "matcher": {
            "domain": {
              "exact": "exact.example.com"
            }
          },
          "target": "exit",
