{
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 10801,
      "protocol": "socks",
      "settings": {
        "accounts": [
          {
            "pass": "fixture-password",
            "user": "fixture-user"
          }
        ],
        "auth": "password",
        "ip": "127.0.0.1",
        "udp": true
      },
      "tag": "proxy-in"
    },
    {
      "listen": "127.0.0.1",
      "port": 10802,
      "protocol": "socks",
      "settings": {
        "accounts": [
          {
            "pass": "fixture-password",
            "user": "fixture-user"
          }
        ],
        "auth": "password",
        "ip": "127.0.0.1",
        "udp": true
      },
      "tag": "exit-1-in"
    }
  ],
  "log": {
    "access": "none",
    "loglevel": "warning"
  },
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "address": "192.0.2.10",
        "encryption": "none",
        "flow": "xtls-rprx-vision",
        "id": "00000000-0000-4000-8000-000000000001",
        "port": 443
      },
      "streamSettings": {
        "network": "tcp",
        "realitySettings": {
          "fingerprint": "firefox",
          "publicKey": "test-public-key",
          "serverName": "example.com",
          "shortId": "01234567"
        },
        "security": "reality",
        "sockopt": {
          "dialerProxy": "proxy-fragment",
          "interface": "Ethernet"
        }
      },
      "tag": "proxy"
    },
    {
      "protocol": "trojan",
      "settings": {
        "address": "198.51.100.20",
        "password": "test-password",
        "port": 443
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "sockopt": {
          "dialerProxy": "exit-1-fragment",
          "interface": "Ethernet"
        },
        "tlsSettings": {
          "allowInsecure": false,
          "fingerprint": "chrome",
          "serverName": "example.com"
        }
      },
      "tag": "exit-1"
    },
    {
      "protocol": "freedom",
      "settings": {
        "fragment": {
          "interval": "10-20",
          "length": "50-100",
          "packets": "1-3"
        }
      },
      "streamSettings": {
        "sockopt": {
          "interface": "Ethernet"
        }
      },
      "tag": "proxy-fragment"
    },
    {
      "protocol": "freedom",
      "settings": {
        "fragment": {
          "interval": "10-20",
          "length": "50-100",
          "packets": "tlshello"
        }
      },
      "streamSettings": {
        "sockopt": {
          "interface": "Ethernet"
        }
      },
      "tag": "exit-1-fragment"
    }
  ],
  "routing": {
    "rules": [
      {
        "inboundTag": [
          "proxy-in"
        ],
        "outboundTag": "proxy",
        "type": "field"
      },
      {
        "inboundTag": [
          "exit-1-in"
        ],
        "outboundTag": "exit-1",
        "type": "field"
      }
    ]
  }
}
