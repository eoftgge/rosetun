root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,svg}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Inno Setup reads a script without a BOM as ANSI, so the Russian messages
# would turn into mojibake in the installer.
[*.iss]
charset = utf-8-bom

# Byte-compared fixtures and upstream license texts stay exactly as they are.
[{crates/*/tests/fixtures/**,installer/third-party/**,crates/rosetun-gui/assets/fonts/*.txt}]
insert_final_newline = unset
trim_trailing_whitespace = unset
